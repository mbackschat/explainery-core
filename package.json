{
  "name": "explainery-core",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source visual storytelling on HyperFrames, with themes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "explainery": "bin/explainery.ts"
  },
  "scripts": {
    "build:runtime": "tsc -p runtime",
    "typecheck": "tsc -p . && tsc -p tsconfig.dom.json && tsc -p runtime --noEmit",
    "test": "pnpm typecheck && node --test tests/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "linkedom": "0.18.12",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "gsap": "^3.14.2",
    "hyperframes": "0.8.142"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.142",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
